# Salin file ini jadi .env (atau set sebagai environment variable). JANGAN commit .env.
PORT=3000
# Kunci enkripsi token Meta (64 karakter hex). Kalau kosong, dibuat otomatis di data/.secret.
# Buat manual: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Izinkan pendaftaran akun baru setelah akun pertama dibuat (default: false)
ALLOW_REGISTER=false
# Set true kalau diakses lewat HTTPS (hosting) supaya cookie ditandai Secure
COOKIE_SECURE=false
# Versi Graph API; cek versi terbaru di dokumentasi Meta
GRAPH_VERSION=v23.0
# Instagram Login (OAuth resmi). Isi hanya di environment server/.env lokal.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
INSTAGRAM_API_BASE=https://graph.instagram.com
